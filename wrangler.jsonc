{
  // Accurova Card on Cloudflare Workers (replaces app/main.py on Zeabur). public/ is the card; worker.js handles
  // /api/track, /stats, /healthz. Data: schema accurova_card (thebooleanjulian-db migration 20261103090000).
  // Secrets: STATS_USERNAME, STATS_PASSWORD.
  "name": "accurova-card",
  "account_id": "c580c4403524273d1bece674117472dd",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/stats", "/healthz"]
  },
  // Cutover, in order: apply the migration + `node scripts/provision.mjs <supabase.env> accurova_card <out dir>` in
  // thebooleanjulian-db (prints the Hyperdrive id), copy the old rows across, then uncomment both blocks and deploy.
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<accurova-card-db id from provision.mjs>" }],
  // "routes": [{ "pattern": "card.accurova.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
